# Copy this file to .env and fill in the values. Never commit .env.
# On Vercel, set these in Project → Settings → Environment Variables instead.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# On your Mac (development): a local SQLite file.
DATABASE_URL="file:./dev.db"
# On Vercel: PostgreSQL (Neon / Vercel Postgres). The Neon integration creates both of these.
# The app switches to PostgreSQL automatically when DATABASE_URL starts with postgres://
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Security (required)
# ---------------------------------------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The app refuses to start in production without a 32+ character value.
JWT_SECRET="replace-with-a-random-string-of-32-plus-characters"

# The app's own address. Used in emails (links and the report logo).
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# On your Mac or a normal server, jobs run by themselves; leave these unset.
# On Vercel, set SCHEDULER=off and a CRON_SECRET (16+ characters). vercel.json calls /api/cron
# four times a day and Vercel sends the secret automatically.
# SCHEDULER=off
# CRON_SECRET=replace-with-a-random-string-of-16-plus-characters

# ---------------------------------------------------------------------------
# Email (7 PM digest and weekly client reports). Optional.
# ---------------------------------------------------------------------------
# Google Workspace: create an App Password for the sending account (Google Account → Security →
# App passwords) and use it as SMTP_PASS. SMTP_HOST=test logs emails instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# e.g. "Markwiz <reports@markwiz.com>"
SMTP_FROM=
# Who gets the 7 PM digest (defaults to the MD's email).
DIGEST_TO=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# AI spell and copy check on uploaded designs. Without it the human proof check still works.
ANTHROPIC_API_KEY=
